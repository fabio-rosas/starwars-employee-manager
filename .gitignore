# ===========================================
# OS-Specific Files
# ===========================================
.DS_Store            # macOS Finder metadata
Thumbs.db            # Windows thumbnail cache
ehthumbs.db
Icon?
Desktop.ini

# ===========================================
# Java / Maven
# ===========================================
target/              # Maven build directory
*.class              # Compiled class files
*.jar                # JAR files
*.war                # WAR files
*.ear                # EAR files

# ===========================================
# Spring Boot
# ===========================================
spring.log           # Spring Boot log file

# ===========================================
# Swagger / OpenAPI
# ===========================================
generated/           # Swagger codegen outputs

# ===========================================
# IntelliJ IDEA
# ===========================================
.idea/               # IntelliJ IDEA settings
*.iml
*.ipr
*.iws
out/                 # IntelliJ output folder

# ===========================================
# Eclipse
# ===========================================
.classpath
.project
.settings/
bin/                 # Eclipse output folder

# ===========================================
# Visual Studio Code
# ===========================================
.vscode/             # VS Code settings

# ===========================================
# Environment Files
# ===========================================
.env                 # Environment variables

# ===========================================
# Logs
# ===========================================
*.log
logs/
*.tmp

# ===========================================
# Temporary Files / System Files
# ===========================================
*.swp
*.swo
*.bak
*.old

# ===========================================
# Windows-specific Files
# ===========================================
$RECYCLE.BIN/
*.lnk

# ===========================================
# Mac-specific Files
# ===========================================
.AppleDouble
.LSOverride
*.DS_Store

# ===========================================
# Node / NPM (if future frontend added)
# ===========================================
node_modules/
dist/
build/

# ===========================================
# Python / Jupyter (in case of AI/ML stuff later)
# ===========================================
__pycache__/
*.py[cod]
*.ipynb_checkpoints